{
  "name": "multiagent-adk-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node --watch --import tsx apps/server/src/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/apps/server/src/index.js --production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "demo:validate": "node --import tsx scripts/validate-demo.ts",
    "adk:validate": "node --import tsx scripts/validate-adk.ts",
    "gemini:check": "node --import tsx scripts/check-gemini.ts",
    "real:validate": "node --import tsx scripts/validate-real.ts",
    "package": "node --import tsx scripts/package.ts",
    "workshop:check": "node --import tsx scripts/workshop.ts",
    "workshop:run": "node --import tsx scripts/workshop.ts",
    "guide:build": "node --import tsx scripts/build-guide.ts",
    "guide:dev": "pnpm guide:build && node --import tsx scripts/serve-guide.ts",
    "workshop:web": "node --import tsx scripts/workshop-web.ts"
  },
  "dependencies": {
    "@google/adk": "2.4.0",
    "@google/genai": "2.32.0",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "fflate": "0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@google/adk-devtools": "2.4.0",
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "marked": "18.1.3",
    "qrcode": "1.5.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
